# Discord (필수)
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# PostgreSQL (필수)
# 로컬에서는 railway.internal 주소를 사용할 수 없습니다.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# 로컬 대시보드 (SESSION_SECRET은 길고 임의의 문자열로 변경)
DASHBOARD_URL=http://localhost:3000
DASHBOARD_PORT=3000
DASHBOARD_HOST=127.0.0.1
CLIENT_SECRET=
SESSION_SECRET=

# 선택 기능
ANTHROPIC_API_KEY=
RIOT_API_KEY=
# /전적 실시간 브리핑 (비우면 기본값: 60일 · 20경기 · AI 설명 사용)
LIVE_BRIEFING_LOOKBACK_DAYS=
LIVE_BRIEFING_MAX_GAMES=
# off로 두면 AI 설명 없이 템플릿 문장만 사용
LIVE_BRIEFING_AI=
LOL_PATCH_CHANNEL_ID=
BOT_OWNER_ID=
